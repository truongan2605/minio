# ─────────────────────────────────────────────
# MinIO Configuration
# ─────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# ─────────────────────────────────────────────
# MySQL Configuration
# ─────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpassword123
MYSQL_DATABASE=storage_db
MYSQL_USER=storage_user
MYSQL_PASSWORD=storage_pass123

# ─────────────────────────────────────────────
# App Configuration (Spring Boot)
# ─────────────────────────────────────────────
APP_PORT=8080
MINIO_ZONE1_ENDPOINT=http://localhost:9000
MINIO_ZONE2_ENDPOINT=http://localhost:9002
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123

# ─────────────────────────────────────────────
# Ngrok Configuration (Optional - 2 Accounts required if exposing public endpoints)
# ─────────────────────────────────────────────
# Account 1 - For Zone 1
NGROK_AUTHTOKEN_1=your_ngrok_authtoken_1
NGROK_DOMAIN_1=your-zone1-domain.ngrok-free.dev

# Account 2 - For Zone 2
NGROK_AUTHTOKEN_2=your_ngrok_authtoken_2
NGROK_DOMAIN_2=your-zone2-domain.ngrok-free.dev
